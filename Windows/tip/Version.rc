// The version of KoEnJa.dll and KoEnJaSettings.exe; the installer (Windows/installer/KoEnJa.iss) reads it from the DLL.
#include <winver.h>

1 VERSIONINFO
FILEVERSION 0, 2, 0, 0
PRODUCTVERSION 0, 2, 0, 0
FILEOS VOS_NT_WINDOWS32
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CIZMO, K.K."
            VALUE "ProductName", "KoEnJa"
            VALUE "FileDescription", "KoEnJa (Korean, English, Japanese input)"
            VALUE "FileVersion", "0.2.0"
            VALUE "ProductVersion", "0.2.0"
            VALUE "LegalCopyright", "Copyright 2026 CIZMO, K.K."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
