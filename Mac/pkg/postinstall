#!/bin/sh
# KoEnJa.pkg's postinstall (from Araso's scripts/pkg/postinstall, MIT). The payload lands in a
# staging folder, not in /Library/Input Methods, and is synced into the existing KoEnJa.app here,
# each file written aside and renamed over the old one (the folder stays, and a running KoEnJa
# keeps its old files until it is stopped). A first install just moves it into place.
#
# KoEnJa: the bundle is then handed to the logged-in user, as Mac/get.sh does, so the input
# method's own updater (and get.sh) can replace its Contents later without a password. The old
# KoEnJa keeps running while that happens (no preinstall stops it: macOS would only start the
# old code again). Stop it after, register the new copy for the logged-in user (the installer
# runs this as root) and refresh the input menu. Adding it in System Settings → Keyboard →
# Input Sources may still be needed; only a copy that couldn't be put in place, or one that didn't
# register while an older copy in ~/Library is kept for it, fails the install.
staged="/Library/Application Support/KoEnJa/Install/KoEnJa.app"
app="/Library/Input Methods/KoEnJa.app"
lock="$app/.install"
# One install at a time, shared by get.sh and the package's postinstall (the same code in both).
# The lock is the folder $lock, made with mkdir (atomic), with its owner's PID in "pid":
# - One whose owner is gone (SIGKILL, power off: no EXIT trap ran) is taken over; a live one never
#   is. ps, not kill -0: that fails for another user's process (get.sh runs as the user, the
#   postinstall as root).
# - One without a PID is an older get.sh's (or one this instant being made): taken over after 10
#   minutes, as older get.sh copies (bundled in installed KoEnJa) take over any lock. So that they
#   never take a live one, its time is kept fresh while the install runs.
# - Taking over is one installer at a time, under "$lock.take" (held for a moment; one left by a
#   kill goes after a minute), looking at the lock again there: one late by a moment then can't
#   remove the lock the first has made since.
# - It is the bundle owner's (the postinstall runs as root), so get.sh can take over one the
#   postinstall left. Released, the loop keeping it fresh is stopped first (its trap: no
#   "Terminated" in the install's output), and it is removed only while it holds this PID; a
#   release finding it taken over says so (fails).
keeper=""
take_lock() {
  if mkdir "$lock" 2>/dev/null; then
    echo $$ >"$lock/pid"; chown "$(stat -f %Su "$app")" "$lock" 2>/dev/null
    # touch -c: a lock removed meanwhile isn't made again (as a file, blocking every install).
    (trap 'exit 0' TERM
     while [ "$(cat "$lock/pid" 2>/dev/null)" = $$ ] && kill -0 $$ 2>/dev/null; do
       touch -c "$lock"; sleep 30 & wait $!; done) </dev/null >/dev/null 2>&1 &
    keeper=$!; return 0
  fi
  owner=$(cat "$lock/pid" 2>/dev/null) || owner=""
  stale_lock "$owner" || return 1
  find "$lock.take" -maxdepth 0 -mmin +1 -exec rm -rf {} + 2>/dev/null
  mkdir "$lock.take" 2>/dev/null || return 1
  if [ "$(cat "$lock/pid" 2>/dev/null)" = "$owner" ] && stale_lock "$owner"; then rm -rf "$lock"; fi
  rmdir "$lock.take"; return 1  # the next try makes it
}
stale_lock() {  # $1: the lock's PID, or nothing
  if [ -n "$1" ]; then ! ps -p "$1" >/dev/null 2>&1
  else [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; fi
}
release_lock() {
  if [ -n "$keeper" ]; then kill "$keeper" 2>/dev/null; wait "$keeper" 2>/dev/null; keeper=""; fi
  [ "$(cat "$lock/pid" 2>/dev/null)" = $$ ] || return 1
  rm -rf "$lock"
}
if [ -d "$staged" ]; then
  if [ -d "$app" ]; then
    # get.sh (and the updater running it) holds $app/.install while it swaps Contents: take the same
    # lock, waiting up to a minute for it; without it nothing is touched. Its staging (.new.*) and
    # the lock aren't payload. The bundle folder itself stays (the lock lives in it, and get.sh's
    # ownership of it): the fallback swaps Contents, as get.sh does.
    i=0; until take_lock; do
      [ $i -lt 600 ] || { echo "KoEnJa: another KoEnJa install is running; the new copy is left at $staged" >&2; exit 1; }
      sleep 0.1; i=$((i+1))
    done
    trap 'release_lock || true' EXIT; locked=1
    # --checksum: a file of the same size and time must still be compared.
    if ! rsync -a --delete --checksum --exclude='/.install' --exclude='/.install.take' --exclude='/.new.*' "$staged/" "$app/"; then
      # Part synced is a mix of old and new files under a broken seal, and the staged copy is the
      # only good one: its Contents whole in place of the old.
      echo "KoEnJa: syncing into $app failed; replacing its Contents" >&2
      if ! { rm -rf "$app/Contents" && mv "$staged/Contents" "$app/Contents"; }; then
        echo "KoEnJa: couldn't put KoEnJa.app into /Library/Input Methods; the new copy is left at $staged" >&2
        exit 1
      fi
    fi
  else
    if ! { mkdir -p "/Library/Input Methods" && mv "$staged" "$app"; }; then
      echo "KoEnJa: couldn't put KoEnJa.app into /Library/Input Methods; the new copy is left at $staged" >&2
      exit 1
    fi
  fi
  # registering below takes a while: the updater needn't wait. A lock no longer this install's
  # was taken over while copying: another install may have written $app at the same time.
  if [ -n "${locked:-}" ] && ! release_lock; then
    trap - EXIT
    echo "KoEnJa: the install lock in $app was taken over during the copy; install KoEnJa again" >&2
    exit 1
  fi
  trap - EXIT
  rm -rf "/Library/Application Support/KoEnJa/Install"
  rmdir "/Library/Application Support/KoEnJa" 2>/dev/null || true
fi
# SIGTERM, then SIGKILL whatever is left, and wait until it is gone: a KoEnJa still running would
# keep the old code, and registering may start one.
pkill -x KoEnJa 2>/dev/null || true
i=0; while pgrep -x KoEnJa >/dev/null && [ $i -lt 30 ]; do sleep 0.1; i=$((i+1)); done
pkill -9 -x KoEnJa 2>/dev/null || true
i=0; while pgrep -x KoEnJa >/dev/null && [ $i -lt 30 ]; do sleep 0.1; i=$((i+1)); done
user=$(stat -f %Su /dev/console)
if [ -n "$user" ] && [ "$user" != root ]; then
  uid=$(id -u "$user")
  as_user() { launchctl asuser "$uid" sudo -u "$user" "$@"; }
  # The user's bundle (get.sh's model): the updater replaces its Contents without a password.
  chown -R "$user" "$app" 2>/dev/null || true
  lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
  # Let LaunchServices take in the changed bundle first: left to --register, the update ran
  # asynchronously beside its TISRegisterInputSource, failed, and the source was gone after.
  as_user "$lsregister" -f "$app" 2>/dev/null || true
  # Then register until a fresh process sees the source (its list is cached per process);
  # that can take 10–30 s.
  i=0; registered=
  while [ $i -lt 30 ]; do
    # Both: --register succeeded for this bundle, and --registered sees its source, launched from
    # it (not a source an older copy left).
    as_user "$app/Contents/MacOS/KoEnJa" --register && as_user "$app/Contents/MacOS/KoEnJa" --registered &&
      { registered=1; break; }
    sleep 1; i=$((i+1))
  done
  # A copy earlier versions put in ~/Library/Input Methods is the same input method twice, and
  # macOS may launch that one: the package's copy replaces it (settings live elsewhere and stay).
  # Only after registering this copy: removed first, it takes the input source (and the user's
  # choice to use it) with it, and KoEnJa is gone from the input menu until it is added again.
  # dscacheutil, not dscl | awk: dscl puts a home with a space on a line of its own.
  home=$(dscacheutil -q user -a name "$user" | sed -n 's/^dir: //p' | head -1)
  if [ -n "$home" ] && [ -d "$home/Library/Input Methods/KoEnJa.app" ]; then
    if [ -n "$registered" ]; then
      as_user "$lsregister" -u "$home/Library/Input Methods/KoEnJa.app" 2>/dev/null || true
      rm -rf "$home/Library/Input Methods/KoEnJa.app"
    else
      echo "KoEnJa: $app didn't register; the old copy in $home/Library/Input Methods is kept" >&2
      kept=1
    fi
  fi
  # Apps that were typing through the old process keep a session with it (keys go nowhere, no
  # menu items) until the input source changes: switched away and back when KoEnJa is in use.
  [ -z "$registered" ] || as_user "$app/Contents/MacOS/KoEnJa" --reselect 2>/dev/null || true
  as_user killall TextInputMenuAgent 2>/dev/null || true
  # The switch indicator by the caret keeps the icon it read first (they ignore SIGTERM).
  as_user killall -KILL CursorUIViewService TextInputSwitcher 2>/dev/null || true
  # Unregistered, the old copy is the user's only working one: the install says it failed.
  [ -z "${kept:-}" ] || exit 1
fi
exit 0
